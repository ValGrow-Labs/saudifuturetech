# Public Website Configuration
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Saudi Future Tech"
NEXT_PUBLIC_SITE_TAGLINE="The Future Is Being Built Today."

# ------------------------------------------------------------------------------
# Database Persistence (PostgreSQL / Prisma ORM)
# ------------------------------------------------------------------------------
# Standard Connection URL Format:
# postgresql://<USERNAME>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
#
# Examples:
# Local TCP: postgresql://postgres:postgres@localhost:5432/saudi_future_tech?schema=public
# Local Unix Socket: postgresql://<USER>@localhost:5433/saudi_future_tech?host=/tmp
# Managed Cloud (Neon/Supabase): postgresql://<USER>:<PASS>@<HOST>/<DATABASE>?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://username:password@localhost:5432/saudi_future_tech?schema=public"

